# 交易助手环境变量配置示例

# Binance API 配置
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here
BINANCE_TESTNET=true

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Telegram 配置（可选）
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# 服务配置
LOG_LEVEL=info
BASE_URL=localhost

# 交易配置
POSITION_MODE=both

# 认证配置
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here
JWT_SECRET=your_jwt_secret_key_here_should_be_at_least_32_characters_long

# 安全提示：
# 1. 复制此文件为 .env 并填入真实配置
# 2. 确保 .env 文件已添加到 .gitignore 中
# 3. 使用强密码和安全的密钥
# 4. 定期轮换 API 密钥和密码
# 5. 服务器固定运行在8080端口
# 6. BASE_URL 配置示例：
#    - BASE_URL=localhost (本地开发)
#    - BASE_URL=127.0.0.1 (本地IP)
#    - BASE_URL=192.168.1.100 (局域网IP)
#    - BASE_URL=your-domain.com (生产域名)
